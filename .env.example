NODE_ENV=development
PORT=3500
# Logger verbosity: info (default) | warn | error | silent.
# Use 'warn' to hide per-request 2xx request_completed logs while keeping 4xx/5xx.
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales
# Separate database used by integration tests (never the dev/prod DB)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/sales_test

ACCESS_TOKEN_SECRET=changeme_access
REFRESH_TOKEN_SECRET=changeme_refresh
# Used to encrypt stored third-party API keys (e.g. AI provider keys) at rest.
# Optional: falls back to ACCESS_TOKEN_SECRET if unset. Set a dedicated value in production.
AI_ENCRYPTION_KEY=changeme_ai_encryption
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=1h
EMAIL_VERIFICATION_EXPIRES_IN=24h

APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Resend email
RESEND_API_KEY=
RESEND_FROM=

# SMTP email (optional alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Auth cookies
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_DOMAIN=
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
CSRF_COOKIE_NAME=csrfToken
CSRF_COOKIE_SAMESITE=lax
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_DOMAIN=
CSRF_COOKIE_PATH=/

# Error reporting
SENTRY_DSN=
GLITCHTIP_DSN=
APP_RELEASE=
ERROR_REPORTING_TRACES_SAMPLE_RATE=0
ERROR_REPORTING_HEALTHCHECK_SLUG=
ERROR_REPORTING_HEALTHCHECK_SCHEDULE=
ERROR_REPORTING_HEALTHCHECK_MARGIN=5
ERROR_REPORTING_HEALTHCHECK_MAX_RUNTIME=60
ERROR_REPORTING_HEALTHCHECK_TIMEZONE=UTC

# Platform super admin — used by `npm run db:seed:admin`
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# Optional data retention
AUDIT_LOG_RETENTION_DAYS=
