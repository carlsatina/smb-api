generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  CASHIER
  INVENTORY_MANAGER
  VIEWER
}

enum PlanTier {
  STARTER
  STANDARD
  GROWTH
}

enum ProductType {
  READY_MADE
  RECIPE
}

enum MovementType {
  SALE
  PURCHASE_RECEIPT
  STOCK_ADJUSTMENT
  WASTE
  REFUND
  VOID
  TRANSFER_OUT
  TRANSFER_IN
}

enum StoreType {
  RETAIL
  WAREHOUSE
}

enum AiProvider {
  OPENAI
  ANTHROPIC
}

enum ExpenseSource {
  MANUAL
  DAILY_SALES
}

enum SaleStatus {
  DRAFT
  FINALIZED
  VOIDED
}

enum OrderType {
  DINE_IN
  TAKEOUT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  GCASH
  MAYA
  OTHER
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ItemType {
  PRODUCT
  INGREDIENT
}

enum IngredientCategory {
  RAW_MATERIAL
  PACKAGING
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  fullName           String?
  emailVerifiedAt    DateTime?
  subscriptionActive Boolean   @default(true)
  payPerReceipt      Boolean   @default(false)
  planTier           PlanTier  @default(STARTER)
  grantedPlan        PlanTier?
  grantedUntil       DateTime?
  isSuperAdmin       Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships             StoreMember[]
  invites                 StoreInvite[]            @relation("InvitedBy")
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]               @relation("Actor")
  sales                   Sale[]                   @relation("Cashier")
  receipts                PurchaseReceipt[]        @relation("ReceivedBy")
  movements               InventoryMovement[]      @relation("CreatedBy")
  userFeatures            UserFeature[]            @relation("UserFeatureUser")
  grantedUserFeatures     UserFeature[]            @relation("UserFeatureGrantedBy")
  dailySalesEntries       DailySalesEntry[]        @relation("DailySalesCreatedBy")
  dailySalesGoals         DailySalesGoal[]         @relation("DailySalesGoalCreatedBy")
  cashierEntries          DailySalesCashierEntry[] @relation("CashierEntryUser")
  billingNoticesSent      BillingNotice[]          @relation("BillingNoticeSentBy")
  expenses                Expense[]                @relation("ExpenseCreatedBy")
  staffCompensations      StaffCompensation[]      @relation("StaffCompensationCreatedBy")
  scheduleWeeks           ScheduleWeek[]           @relation("ScheduleWeekCreatedBy")
  cashAdvances            CashAdvance[]            @relation("CashAdvanceCreatedBy")
}

model BillingNotice {
  id           String   @id @default(cuid())
  storeId      String
  year         Int
  month        Int
  receiptCount Int
  feeRate      Decimal  @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(12, 2)
  sentToEmail  String
  sentById     String
  sentAt       DateTime @default(now())

  store  Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sentBy User  @relation("BillingNoticeSentBy", fields: [sentById], references: [id])

  // Append-only billing log: one row per send (no upsert), so resends are
  // recorded individually. The "last billed" is just the most recent row.
  @@index([storeId, year, month])
  @@index([sentAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Store {
  id                       String      @id @default(cuid())
  name                     String
  storeType                StoreType   @default(RETAIL)
  timezone                 String      @default("Asia/Manila")
  currency                 String      @default("PHP")
  unitOptions              String[]    @default([])
  categoryOptions          String[]    @default([])
  expenseCategoryOptions   String[]    @default([])
  allowNegativeStock       Boolean     @default(false)
  lowStockThreshold        Decimal     @default(0) @db.Decimal(12, 4)
  defaultTaxRate           Decimal     @default(0) @db.Decimal(5, 2)
  defaultDiscount          Decimal     @default(0) @db.Decimal(12, 2)
  cashierSalesHistoryLimit Int?
  paymentMethods           String[]    @default(["CASH", "CARD", "TRANSFER", "GCASH", "MAYA", "OTHER"])
  aiProvider               AiProvider?
  aiModel                  String?
  aiApiKeyEncrypted        String?
  aiApiKeyLast4            String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  deletedAt                DateTime?

  members            StoreMember[]
  invites            StoreInvite[]
  products           Product[]
  ingredients        Ingredient[]
  recipes            Recipe[]
  sales              Sale[]
  purchaseOrders     PurchaseOrder[]
  receipts           PurchaseReceipt[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]
  suppliers          Supplier[]
  dailySalesEntries  DailySalesEntry[]
  dailySalesGoals    DailySalesGoal[]
  billingNotices     BillingNotice[]
  expenses           Expense[]
  shiftPresets       ShiftPreset[]
  staffCompensations StaffCompensation[]
  scheduleWeeks      ScheduleWeek[]
  cashAdvances       CashAdvance[]
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      Role
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  compensations    StaffCompensation[]
  scheduleWeekRows ScheduleWeekRow[]
  cashAdvances     CashAdvance[]

  @@unique([storeId, userId])
  @@index([storeId, createdAt])
  @@index([userId])
}

model StoreInvite {
  id          String    @id @default(cuid())
  storeId     String
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([storeId, email])
  @@index([storeId, createdAt])
}

model Product {
  id                String      @id @default(cuid())
  storeId           String
  name              String
  type              ProductType
  sku               String?
  barcode           String?
  price             Decimal     @db.Decimal(12, 2)
  cost              Decimal?    @db.Decimal(12, 2)
  unit              String
  category          String?
  active            Boolean     @default(true)
  lowStockThreshold Decimal?    @db.Decimal(12, 4)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recipe               Recipe?
  saleItems            SaleItem[]
  packagingLines       ProductPackaging[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([storeId, createdAt])
}

model Ingredient {
  id                String             @id @default(cuid())
  storeId           String
  name              String
  unit              String
  category          IngredientCategory @default(RAW_MATERIAL)
  costPerUnit       Decimal            @db.Decimal(12, 4)
  purchaseUnit      String?
  purchaseUnitSize  Decimal?           @db.Decimal(12, 4)
  active            Boolean            @default(true)
  lowStockThreshold Decimal?           @db.Decimal(12, 4)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines                RecipeLine[]
  packagingLines       ProductPackaging[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]

  @@unique([storeId, name])
  @@index([storeId, createdAt])
}

model Recipe {
  id        String    @id @default(cuid())
  storeId   String
  productId String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  store   Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines   RecipeLine[]

  @@index([storeId, createdAt])
}

model RecipeLine {
  id                String  @id @default(cuid())
  recipeId          String
  ingredientId      String
  qtyPerProductUnit Decimal @db.Decimal(12, 4)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
}

model ProductPackaging {
  id           String  @id @default(cuid())
  productId    String
  ingredientId String
  qtyPerUnit   Decimal @db.Decimal(12, 4)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([productId])
}

model InventoryMovement {
  id                    String       @id @default(cuid())
  storeId               String
  itemType              ItemType
  itemId                String
  qtyDelta              Decimal      @db.Decimal(12, 4)
  unitCost              Decimal?     @db.Decimal(12, 4)
  type                  MovementType
  referenceType         String?
  referenceId           String?
  note                  String?
  createdById           String?
  counterpartStoreId    String?
  counterpartMovementId String?
  createdAt             DateTime     @default(now())

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, itemType, itemId])
}

model Sale {
  id            String        @id @default(cuid())
  storeId       String
  cashierId     String
  status        SaleStatus    @default(DRAFT)
  receiptNumber Int?
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  orderType     OrderType     @default(DINE_IN)
  createdAt     DateTime      @default(now())
  finalizedAt   DateTime?
  voidedAt      DateTime?
  deletedAt     DateTime?

  store   Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier User       @relation("Cashier", fields: [cashierId], references: [id])
  items   SaleItem[]

  @@unique([storeId, receiptNumber])
  @@index([storeId, createdAt])
  @@index([storeId, status, createdAt])
}

model SaleItem {
  id           String  @id @default(cuid())
  saleId       String
  productId    String
  qty          Decimal @db.Decimal(12, 4)
  unitPrice    Decimal @db.Decimal(12, 2)
  discount     Decimal @db.Decimal(12, 2)
  tax          Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)
  nameSnapshot String

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
}

model Supplier {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([storeId, name])
  @@index([storeId, createdAt])
}

model Expense {
  id          String        @id @default(cuid())
  storeId     String
  date        DateTime      @db.Date
  amount      Decimal       @db.Decimal(12, 2)
  category    String
  note        String?
  source      ExpenseSource @default(MANUAL)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User  @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([storeId, date])
  @@index([storeId, createdAt])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  storeId      String
  supplierId   String?
  supplierName String?
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  store    Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]

  @@index([storeId, createdAt])
  @@index([storeId, status, createdAt])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  itemType        ItemType @default(PRODUCT)
  productId       String?
  ingredientId    String?
  qtyOrdered      Decimal  @db.Decimal(12, 4)
  qtyReceived     Decimal  @default(0) @db.Decimal(12, 4)
  unitCost        Decimal  @db.Decimal(12, 4)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])
  ingredient    Ingredient?   @relation(fields: [ingredientId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@unique([purchaseOrderId, ingredientId])
}

model PurchaseReceipt {
  id              String   @id @default(cuid())
  storeId         String
  purchaseOrderId String?
  invoiceNumber   String?
  receivedById    String
  receivedAt      DateTime @default(now())
  totalCost       Decimal  @db.Decimal(12, 2)

  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  receivedBy    User                  @relation("ReceivedBy", fields: [receivedById], references: [id])
  items         PurchaseReceiptItem[]

  @@index([storeId, receivedAt])
}

model PurchaseReceiptItem {
  id           String   @id @default(cuid())
  receiptId    String
  itemType     ItemType @default(PRODUCT)
  productId    String?
  ingredientId String?
  qtyReceived  Decimal  @db.Decimal(12, 4)
  unitCost     Decimal  @db.Decimal(12, 4)

  receipt    PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id])
  ingredient Ingredient?     @relation(fields: [ingredientId], references: [id])

  @@index([receiptId])
}

model AuditLog {
  id         String   @id @default(cuid())
  storeId    String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor User? @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, action, createdAt])
  @@index([storeId, actorId, createdAt])
}

model UserFeature {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserFeatureUser", fields: [userId], references: [id], onDelete: Cascade)
  feature     String
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  grantedById String
  grantedBy   User      @relation("UserFeatureGrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, feature])
  @@index([userId])
}

model DailySalesGoal {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  goal          Decimal  @db.Decimal(12, 2)
  effectiveDate DateTime @db.Date
  createdById   String
  createdBy     User     @relation("DailySalesGoalCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([storeId, effectiveDate])
  @@index([storeId, effectiveDate])
}

model DailySalesEntry {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date           DateTime  @db.Date
  // null = derive from itemized expenses for the date; non-null = manual override.
  expense        Decimal?  @db.Decimal(12, 2)
  seniorDiscount Decimal   @default(0) @db.Decimal(12, 2)
  actualCoh      Decimal?  @db.Decimal(12, 2)
  createdById    String
  createdBy      User      @relation("DailySalesCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  cashierEntries DailySalesCashierEntry[]

  @@unique([storeId, date])
  @@index([storeId, date])
}

model DailySalesCashierEntry {
  id                String          @id @default(cuid())
  dailySalesEntryId String
  dailySalesEntry   DailySalesEntry @relation(fields: [dailySalesEntryId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation("CashierEntryUser", fields: [userId], references: [id])
  cashAmount        Decimal         @default(0) @db.Decimal(12, 2)
  gcashAmount       Decimal         @default(0) @db.Decimal(12, 2)
  denom1000         Int             @default(0)
  denom500          Int             @default(0)
  denom200          Int             @default(0)
  denom100          Int             @default(0)
  denom50           Int             @default(0)
  denom20           Int             @default(0)
  coins             Decimal         @default(0) @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([dailySalesEntryId, userId])
  @@index([dailySalesEntryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Staff scheduling & weekly payout
//
// Weeks are materialised rather than derived from a recurrence rule: rest days
// and shifts move around week to week, and each week carries its own OT, cash
// advance deductions and payout. `ShiftPreset` + "copy last week" cover the
// "usual pattern" need without recurrence machinery.
// ─────────────────────────────────────────────────────────────────────────────

enum ScheduleWeekStatus {
  DRAFT
  PUBLISHED
}

// Named shift patterns (e.g. "9AM - 6PM") so filling the grid is one click.
model ShiftPreset {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label       String
  // Presentation token (see SHIFT_ICONS), not a raw icon name — the glyph
  // vocabulary is a UI concern and grows without a migration.
  icon        String    @default("none")
  startMinute Int
  endMinute   Int
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  shifts ScheduleShift[]

  @@index([storeId, sortOrder])
}

// Per-member pay rates, effective-dated so a raise never rewrites history.
model StaffCompensation {
  id            String      @id @default(cuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeMemberId String
  storeMember   StoreMember @relation(fields: [storeMemberId], references: [id], onDelete: Cascade)
  dailyRate     Decimal     @db.Decimal(12, 2)
  // Hourly OT rate = (dailyRate / hoursPerDay) * otMultiplier.
  hoursPerDay   Decimal     @default(8) @db.Decimal(4, 2)
  // Unpaid break deducted from each worked day when OT is computed from the
  // roster. 0 keeps scheduled hours as-is.
  breakMinutes  Int         @default(0)
  otMultiplier  Decimal     @default(1) @db.Decimal(4, 2)
  effectiveFrom DateTime    @db.Date
  effectiveTo   DateTime?   @db.Date
  createdById   String
  createdBy     User        @relation("StaffCompensationCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([storeMemberId, effectiveFrom])
  @@index([storeId])
}

model ScheduleWeek {
  id          String             @id @default(cuid())
  storeId     String
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Always the store's configured week start day (Sunday by default).
  weekStart   DateTime           @db.Date
  status      ScheduleWeekStatus @default(DRAFT)
  publishedAt DateTime?
  createdById String
  createdBy   User               @relation("ScheduleWeekCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  rows ScheduleWeekRow[]

  @@unique([storeId, weekStart])
  @@index([storeId, weekStart])
}

// One staff member's line in a week: the shift cells plus the payout columns.
model ScheduleWeekRow {
  id             String       @id @default(cuid())
  scheduleWeekId String
  scheduleWeek   ScheduleWeek @relation(fields: [scheduleWeekId], references: [id], onDelete: Cascade)
  storeMemberId  String
  storeMember    StoreMember  @relation(fields: [storeMemberId], references: [id], onDelete: Cascade)
  // Derived from the roster when otAuto, otherwise a manual override for this
  // week. Both are kept because identical shift patterns can legitimately carry
  // different OT — the owner overrides the computed figure when they do.
  otHours        Decimal      @default(0) @db.Decimal(6, 2)
  otAuto         Boolean      @default(true)
  remarks        String?
  sortOrder      Int          @default(0)
  // Rates are snapshotted on publish so a later raise cannot retroactively
  // change a settled week. Null while the week is still DRAFT.
  dailyRate      Decimal?     @db.Decimal(12, 2)
  otHourlyRate   Decimal?     @db.Decimal(12, 2)
  daysWorked     Int?
  lessCa         Decimal?     @db.Decimal(12, 2)
  payout         Decimal?     @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shifts       ScheduleShift[]
  caDeductions CashAdvanceDeduction[]

  @@unique([scheduleWeekId, storeMemberId])
  @@index([scheduleWeekId])
  @@index([storeMemberId])
}

model ScheduleShift {
  id                String          @id @default(cuid())
  scheduleWeekRowId String
  scheduleWeekRow   ScheduleWeekRow @relation(fields: [scheduleWeekRowId], references: [id], onDelete: Cascade)
  date              DateTime        @db.Date
  // The red "RD" cell. Explicit, so "deliberately off" is distinguishable from
  // "not scheduled yet" (no row).
  isRestDay         Boolean         @default(false)
  // Minutes from local midnight in the store's timezone. endMinute may exceed
  // 1440 for overnight shifts. Null when isRestDay.
  startMinute       Int?
  endMinute         Int?
  presetId          String?
  preset            ShiftPreset?    @relation(fields: [presetId], references: [id], onDelete: SetNull)

  @@unique([scheduleWeekRowId, date])
  @@index([scheduleWeekRowId])
}

// Cash advance ledger — replaces the hand-maintained "ca bal: …" remark.
model CashAdvance {
  id            String      @id @default(cuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeMemberId String
  storeMember   StoreMember @relation(fields: [storeMemberId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(12, 2)
  takenOn       DateTime    @db.Date
  note          String?
  createdById   String
  createdBy     User        @relation("CashAdvanceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?

  deductions CashAdvanceDeduction[]

  @@index([storeId, storeMemberId])
  @@index([storeMemberId, takenOn])
}

model CashAdvanceDeduction {
  id                String          @id @default(cuid())
  cashAdvanceId     String
  cashAdvance       CashAdvance     @relation(fields: [cashAdvanceId], references: [id], onDelete: Cascade)
  scheduleWeekRowId String
  scheduleWeekRow   ScheduleWeekRow @relation(fields: [scheduleWeekRowId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(12, 2)
  // A deliberately skipped week is recorded as amount 0 with a reason, so the
  // decision is visible rather than looking like missing data.
  skipped           Boolean         @default(false)
  reason            String?
  createdAt         DateTime        @default(now())

  @@unique([cashAdvanceId, scheduleWeekRowId])
  @@index([scheduleWeekRowId])
}
